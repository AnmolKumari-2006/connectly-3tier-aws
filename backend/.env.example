# ============================================================================
#  Connectly backend (application tier) configuration
#  Copy this file to .env and fill in real values:   cp .env.example .env
# ============================================================================

# ---- Application -----------------------------------------------------------
PORT=4000
NODE_ENV=development
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production
# Address(es) the browser uses to open the site, comma separated.
# 8080 = web tier (npm start in frontend), 5173 = dev server (npm run dev).
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173
# Set to true ONLY after you add HTTPS (SSL certificate) to the web tier.
COOKIE_SECURE=false
# The API sits behind the web tier proxy, so trust its X-Forwarded-* headers.
TRUST_PROXY=true

# ---- Database (PostgreSQL / Amazon RDS) -------------------------------------
# Local:  DB_HOST=localhost
# AWS:    DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
DB_USER=connectly
DB_PASSWORD=connectly_pass
DB_NAME=connectly
# Must be true for Amazon RDS (RDS PostgreSQL forces SSL connections).
DB_SSL=false
DB_POOL_MAX=10

# Alternatively, one connection string instead of the DB_* values above:
# DATABASE_URL=postgres://connectly:password@host:5432/connectly

# ---- File storage ------------------------------------------------------------
# local = save uploads in backend/uploads (your computer)
# s3    = save uploads in an Amazon S3 bucket (AWS). Needs S3_BUCKET; access
#         comes from the EC2 instance's IAM role, so no keys are written here.
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=ap-south-1

# Show the demo accounts on the login page (turn off for a real deployment).
DEMO_MODE=true
